<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  launchd 配置模板（仅供参考 / 手动安装用）。
  推荐直接运行 ./install.sh，它会按你本机的实际路径自动生成并加载这个文件。

  手动使用时，把下面所有 YOUR_NAME 替换成你的用户名，
  并确认 server.py 的路径与你 clone 的位置一致。
  Apple Silicon 的 Homebrew 在 /opt/homebrew，Intel Mac 在 /usr/local。
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.user.ytdlp-server</string>

    <key>ProgramArguments</key>
    <array>
        <string>/opt/homebrew/bin/python3</string>
        <string>/Users/YOUR_NAME/yt-dlp-chrome-extension/server.py</string>
    </array>

    <!-- 环境变量（launchd 默认环境极简，需手动补充） -->
    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>/Users/YOUR_NAME</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>YTDLP_COOKIE_SOURCES</key>
        <string>chrome,safari</string>
        <key>YT_DLP_BIN</key>
        <string>/opt/homebrew/bin/yt-dlp</string>
        <!-- 可选配置，含义见 README「配置项」：
        <key>YTDLP_SAVE_DIR</key>
        <string>~/Downloads</string>
        <key>YTDLP_AUTO_UPDATE</key>
        <string>0</string>
        <key>YTDLP_DOWNLOAD_TIMEOUT</key>
        <string>7200</string>
        -->
    </dict>

    <!-- 登录时自动启动 -->
    <key>RunAtLoad</key>
    <true/>

    <!-- 意外退出后自动重启 -->
    <key>KeepAlive</key>
    <true/>

    <!-- 日志输出位置 -->
    <key>StandardOutPath</key>
    <string>/tmp/ytdlp-server.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/ytdlp-server.log</string>
</dict>
</plist>
